---
import { Image } from 'astro:assets';
import { categoryLabel } from '../consts';
import { formatDate, isoDate, type Post, readingMinutes, withBase } from '../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, categories, thumbnail, draft } = post.data;
---

<article class="post-card">
	<a href={withBase(`posts/${post.id}/`)} class="post-card-link">
		<div class="post-card-body">
			<span class="post-card-category">{categoryLabel(categories[0])}</span>
			<h2 class="post-card-title">
				{title}
				{draft && <span class="draft-badge">초안</span>}
			</h2>
			<p class="post-card-desc">{description}</p>
			<div class="post-card-meta">
				<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
				<span class="dot" aria-hidden="true"></span>
				<span>{readingMinutes(post.body)}분 읽기</span>
			</div>
		</div>
		{
			thumbnail && (
				<div class="post-card-thumb">
					<Image src={thumbnail} alt="" width={440} height={292} loading="lazy" />
				</div>
			)
		}
	</a>
</article>

<style>
	.post-card-link {
		display: flex;
		align-items: center;
		gap: 40px;
		padding: 28px 0;
	}

	.post-card-body {
		flex: 1;
		min-width: 0;
	}

	.post-card-category {
		display: inline-block;
		margin-bottom: 8px;
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
	}

	.post-card-title {
		margin: 0;
		font-size: 22px;
		line-height: 1.45;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
		transition: color 0.15s ease;
	}

	.post-card-link:hover .post-card-title {
		color: var(--accent);
	}

	.post-card-desc {
		margin: 8px 0 0;
		font-size: 16px;
		line-height: 1.65;
		color: var(--text-sub);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 14px;
		font-size: 14px;
		color: var(--text-muted);
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
	}

	.post-card-thumb {
		flex: none;
		width: 220px;
		aspect-ratio: 3 / 2;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-soft);
	}

	.post-card-thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.post-card-link:hover .post-card-thumb :global(img) {
		transform: scale(1.04);
	}

	@media (max-width: 640px) {
		.post-card-link {
			align-items: flex-start;
			gap: 16px;
			padding: 22px 0;
		}

		.post-card-title {
			font-size: 18px;
		}

		.post-card-desc {
			font-size: 15px;
		}

		.post-card-thumb {
			width: 96px;
			aspect-ratio: 1;
			border-radius: var(--radius-sm);
			margin-top: 30px;
		}
	}
</style>
