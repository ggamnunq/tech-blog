---
import { withBase } from '../lib/posts';

interface Props {
	code: '403' | '404';
	title: string;
	description: string;
	/** 403일 때 요청한 주소를 보여 줄지 (?from= 값) */
	showFrom?: boolean;
}

const { code, title, description, showFrom = false } = Astro.props;
---

<section class:list={['error', `is-${code}`]}>
	<div class="error-icon" aria-hidden="true">
		{
			code === '403' ? (
				<svg viewBox="0 0 48 48" width="40" height="40">
					<rect x="11" y="21" width="26" height="19" rx="5" fill="currentColor" />
					<path d="M17 21v-5a7 7 0 0 1 14 0v5" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
					<circle cx="24" cy="30" r="3" fill="#fff" />
				</svg>
			) : (
				<svg viewBox="0 0 48 48" width="40" height="40">
					<circle cx="21" cy="21" r="11" fill="none" stroke="currentColor" stroke-width="4" />
					<path d="M29.5 29.5 38 38" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
					<path d="M17 21h8" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
				</svg>
			)
		}
	</div>
	<p class="error-code">{code === '403' ? '403 Forbidden' : '404 Not Found'}</p>
	<h1 class="error-title">{title}</h1>
	<p class="error-desc">{description}</p>
	{showFrom && <p class="error-from" data-error-from hidden />}
	<div class="error-actions">
		<a class="btn btn-primary" href={withBase('/')}>홈으로 가기</a>
		<button class="btn btn-secondary" type="button" data-error-back>이전 페이지</button>
	</div>
	<slot />
</section>

<style>
	.error {
		max-width: 560px;
		margin: 0 auto;
		padding: 120px 24px 0;
		text-align: center;
	}

	.error-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		margin-bottom: 28px;
		border-radius: 24px;
		color: var(--accent);
		background: var(--accent-soft);
	}

	.is-403 .error-icon {
		color: #e5484d;
		background: #fdeeee;
	}

	.error-code {
		margin: 0;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--accent);
	}

	.is-403 .error-code {
		color: #c92a2a;
	}

	.error-title {
		margin: 10px 0 0;
		font-size: 30px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.error-desc {
		margin: 12px 0 0;
		font-size: 17px;
		color: var(--text-sub);
	}

	.error-from {
		display: inline-block;
		max-width: 100%;
		margin: 20px 0 0;
		padding: 8px 14px;
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-sub);
		background: var(--bg-soft);
		overflow-wrap: anywhere;
	}

	.error-actions {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-top: 36px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		height: 48px;
		padding: 0 22px;
		border: 0;
		border-radius: var(--radius);
		font-size: 16px;
		font-weight: 600;
		transition: background-color 0.15s ease;
	}

	.btn-primary {
		color: #fff;
		background: var(--accent);
	}

	.btn-primary:hover {
		background: var(--accent-strong);
	}

	.btn-secondary {
		color: var(--text-sub);
		background: var(--bg-soft);
	}

	.btn-secondary:hover {
		background: #e5e8eb;
	}

	@media (max-width: 640px) {
		.error {
			padding-top: 72px;
		}

		.error-title {
			font-size: 24px;
		}
	}
</style>

<script>
	const back = document.querySelector<HTMLButtonElement>('[data-error-back]');
	back?.addEventListener('click', () => {
		if (history.length > 1) history.back();
		else location.href = document.querySelector<HTMLAnchorElement>('.btn-primary')?.href ?? '/';
	});

	const from = document.querySelector<HTMLElement>('[data-error-from]');
	const requested = new URLSearchParams(location.search).get('from');
	if (from && requested) {
		from.textContent = `요청한 주소: ${requested}`;
		from.hidden = false;
	}
</script>
