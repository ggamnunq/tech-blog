---
import CategoryTabs from '../components/CategoryTabs.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.title,
	description: SITE.description,
	url: new URL(import.meta.env.BASE_URL, Astro.site).toString(),
	inLanguage: 'ko',
	author: { '@type': 'Person', name: SITE.author, url: SITE.github },
};
---

<BaseLayout jsonLd={jsonLd}>
	<div class="container">
		<section class="page-head">
			<h1>{SITE.heroTitle}</h1>
			<p>{SITE.description}</p>
		</section>
		<CategoryTabs posts={posts} current="all" />
		<PostList posts={posts} />
	</div>
</BaseLayout>
