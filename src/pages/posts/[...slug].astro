---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import '../../styles/prose.css';
import SeriesBox from '../../components/SeriesBox.astro';
import Toc from '../../components/Toc.astro';
import { categoryLabel, findSeries, SITE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, isoDate, isoDateKst, type Post, seriesPosts, tagSlug, withBase } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: posts[i - 1],
			older: posts[i + 1],
			parts: post.data.series ? seriesPosts(posts, post.data.series) : [],
		},
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
	parts: Post[];
}

const { post, newer, older, parts } = Astro.props;
const partIndex = parts.findIndex((p) => p.id === post.id);
const nextPart = partIndex >= 0 ? parts[partIndex + 1] : undefined;
const { Content, headings } = await render(post);
const { title, seoTitle, description, pubDate, updatedDate, workPeriod, categories, tags, thumbnail, draft } = post.data;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: seoTitle ?? title,
	description,
	datePublished: isoDateKst(pubDate),
	dateModified: isoDateKst(updatedDate ?? pubDate),
	inLanguage: 'ko',
	url: canonical,
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
	author: { '@type': 'Person', name: SITE.author, url: SITE.github },
	publisher: { '@type': 'Person', name: SITE.author, url: SITE.github },
	keywords: tags.join(', '),
	...(thumbnail ? { image: new URL(thumbnail.src, Astro.site).toString() } : {}),
	...(post.data.series ? { isPartOf: { '@type': 'CreativeWorkSeries', name: findSeries(post.data.series)?.title } } : {}),
};
---

<BaseLayout
	title={seoTitle ?? title}
	description={description}
	image={thumbnail?.src}
	type="article"
	article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
	jsonLd={jsonLd}
>
	<div class="container post-layout">
		<article class="post">
			<header class="post-header">
				<div class="post-categories">
					{
						categories.map((c, i) => (
							<>
								{i > 0 && <span class="post-category-sep" aria-hidden="true">·</span>}
								<a class="post-category" href={withBase(`category/${c}/`)}>
									{categoryLabel(c)}
								</a>
							</>
						))
					}
				</div>
				<h1 class="post-title">
					{title}
					{draft && <span class="draft-badge">초안 · 배포 안 됨</span>}
				</h1>
				<div class="post-meta">
					<img class="avatar" src={withBase(SITE.avatar)} alt="" width="36" height="36" loading="lazy" />
					<div>
						<p class="meta-author">{SITE.author}</p>
						<p class="meta-sub">
							<span>게시 <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time></span>
							{
								updatedDate && (
									<>
										<span aria-hidden="true">·</span>
										<span>수정 {formatDate(updatedDate)}</span>
									</>
								)
							}
							{
								workPeriod && (
									<>
										<span aria-hidden="true">·</span>
										<span title="실제로 작업한 시기">작업 {workPeriod}</span>
									</>
								)
							}
						</p>
					</div>
				</div>
			</header>

			{
				thumbnail && (
					<div class="post-hero">
						<Image src={thumbnail} alt="" width={1440} loading="eager" />
					</div>
				)
			}

			{post.data.series && parts.length > 0 && <SeriesBox series={post.data.series} parts={parts} currentId={post.id} />}

			<div class="prose">
				<Content />
			</div>

			{
				nextPart && (
					<a class="series-next" href={withBase(`posts/${nextPart.id}/`)}>
						<span class="series-next-label">시리즈 다음 글 · {nextPart.data.seriesOrder}편</span>
						<span class="series-next-title">{nextPart.data.title}</span>
					</a>
				)
			}

			{
				tags.length > 0 && (
					<ul class="post-tags" aria-label="태그">
						{tags.map((tag) => (
							<li>
								<a class="tag" href={withBase(`tags/${tagSlug(tag)}/`)}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}

			<section class="author-card" aria-label="작성자">
				<img class="author-avatar" src={withBase(SITE.avatar)} alt="" width="56" height="56" loading="lazy" />
				<div>
					<p class="author-name">{SITE.author}</p>
					<p class="author-desc">{SITE.description}</p>
				</div>
				<a class="author-link" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
			</section>

			{
				(newer || older) && (
					<nav class="post-nav" aria-label="이전·다음 글">
						{older ? (
							<a class="post-nav-item" href={withBase(`posts/${older.id}/`)}>
								<span class="post-nav-label">이전 글</span>
								<span class="post-nav-title">{older.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{newer && (
							<a class="post-nav-item is-next" href={withBase(`posts/${newer.id}/`)}>
								<span class="post-nav-label">다음 글</span>
								<span class="post-nav-title">{newer.data.title}</span>
							</a>
						)}
					</nav>
				)
			}
		</article>

		<aside class="post-aside">
			<Toc headings={headings} />
		</aside>
	</div>

	<dialog class="lightbox" aria-label="이미지 크게 보기">
		<figure class="lightbox-figure">
			<img class="lightbox-img" alt="" />
			<figcaption class="lightbox-caption"></figcaption>
		</figure>
		<span class="lightbox-count" aria-live="polite"></span>
		<button type="button" class="lightbox-btn lightbox-close" aria-label="닫기">✕</button>
		<button type="button" class="lightbox-btn lightbox-prev" aria-label="이전 이미지">‹</button>
		<button type="button" class="lightbox-btn lightbox-next" aria-label="다음 이미지">›</button>
	</dialog>
</BaseLayout>

<style>
	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, var(--content)) 220px;
		justify-content: space-between;
		gap: 64px;
		padding-top: 64px;
	}

	.post {
		min-width: 0;
	}

	.post-header {
		margin-bottom: 48px;
	}

	.post-categories {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 14px;
		font-size: 15px;
		font-weight: 600;
	}

	.post-category {
		color: var(--accent);
	}

	.post-category-sep {
		color: var(--text-muted);
	}

	.post-category:hover {
		color: var(--accent-strong);
	}

	.post-title {
		margin: 0;
		font-size: 38px;
		line-height: 1.38;
		font-weight: 700;
		letter-spacing: -0.025em;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 12px;
		margin-top: 28px;
	}

	.post-meta > div {
		flex: none;
	}


	.avatar {
		border-radius: 50%;
		background: var(--bg-soft);
	}

	.meta-author {
		margin: 0;
		font-size: 15px;
		font-weight: 600;
	}

	.meta-sub {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 2px 0 0;
		font-size: 14px;
		color: var(--text-muted);
	}

	.post-hero {
		margin-bottom: 48px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--bg-soft);
	}

	.post-hero :global(img) {
		width: 100%;
	}

	.series-next {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 56px;
		padding: 22px 24px;
		border-radius: var(--radius-lg);
		background: var(--accent-soft);
		transition: background-color 0.15s ease;
	}

	.series-next:hover {
		background: #dfe9ff;
	}

	.series-next-label {
		font-size: 13px;
		font-weight: 700;
		color: var(--accent);
	}

	.series-next-title {
		font-size: 18px;
		font-weight: 700;
		color: var(--text);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 56px 0 0;
		padding: 0;
		list-style: none;
	}

	.author-card {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 48px;
		padding: 24px;
		border-radius: var(--radius-lg);
		background: var(--bg-softer);
		border: 1px solid var(--border);
	}

	.author-avatar {
		flex: none;
		border-radius: 50%;
	}

	.author-card > div {
		flex: 1;
		min-width: 0;
	}

	.author-name {
		margin: 0;
		font-size: 17px;
		font-weight: 700;
	}

	.author-desc {
		margin: 4px 0 0;
		font-size: 14px;
		color: var(--text-sub);
	}

	.author-link {
		flex: none;
		padding: 8px 14px;
		border-radius: var(--radius-sm);
		font-size: 14px;
		font-weight: 600;
		color: var(--text-sub);
		background: #fff;
		border: 1px solid var(--border);
	}

	.author-link:hover {
		background: var(--bg-soft);
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		margin-top: 24px;
	}

	.post-nav-item {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 20px 22px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.post-nav-item:hover {
		border-color: #d1d6db;
		background: var(--bg-softer);
	}

	.post-nav-item.is-next {
		text-align: right;
		grid-column: 2;
	}

	.post-nav-label {
		font-size: 13px;
		font-weight: 600;
		color: var(--text-muted);
	}

	.post-nav-title {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.5;
		color: var(--text);
	}

	.post-aside {
		padding-top: 260px;
	}

	@media (max-width: 1080px) {
		.post-layout {
			grid-template-columns: minmax(0, var(--content));
			justify-content: center;
		}

		.post-aside {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.post-layout {
			padding-top: 40px;
		}

		.post-header {
			margin-bottom: 36px;
		}

		.post-title {
			font-size: 28px;
		}


		.author-card {
			flex-wrap: wrap;
		}

		.post-nav {
			grid-template-columns: 1fr;
		}

		.post-nav-item.is-next {
			grid-column: 1;
		}
	}
	/* 이미지 크게 보기 */
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
	}

	.lightbox::backdrop {
		background: rgba(17, 20, 24, 0.9);
	}

	.lightbox-figure {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 56px 72px;
		box-sizing: border-box;
	}

	.lightbox-img {
		max-width: 100%;
		max-height: calc(100dvh - 160px);
		object-fit: contain;
		border-radius: var(--radius-sm);
		cursor: zoom-out;
	}

	.lightbox-caption {
		max-width: 720px;
		font-size: 15px;
		line-height: 1.6;
		text-align: center;
		color: #d1d6db;
	}

	.lightbox-caption:empty {
		display: none;
	}

	.lightbox-count {
		position: fixed;
		top: 20px;
		left: 24px;
		font-size: 14px;
		color: #b0b8c1;
	}

	.lightbox-btn {
		position: fixed;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		font-size: 24px;
		line-height: 1;
		cursor: pointer;
	}

	.lightbox-btn:hover {
		background: rgba(255, 255, 255, 0.24);
	}

	.lightbox-close {
		top: 12px;
		right: 16px;
		font-size: 18px;
	}

	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
		font-size: 30px;
	}

	.lightbox-prev {
		left: 16px;
	}

	.lightbox-next {
		right: 16px;
	}

	.lightbox-btn[hidden] {
		display: none;
	}

	@media (max-width: 640px) {
		.lightbox-figure {
			padding: 56px 12px 72px;
		}

		.lightbox-prev,
		.lightbox-next {
			top: auto;
			bottom: 16px;
			transform: none;
		}
	}
</style>

<script>
	// 표는 가로 스크롤 가능한 래퍼로 감쌈
	for (const table of document.querySelectorAll<HTMLTableElement>('.prose table')) {
		const wrap = document.createElement('div');
		wrap.className = 'table-wrap';
		table.parentNode?.insertBefore(wrap, table);
		wrap.appendChild(table);
	}

	// 코드 블록에 언어 라벨과 복사 버튼 추가
	for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.parentNode?.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);

		const lang = pre.dataset.language;
		if (lang && lang !== 'plaintext') {
			const label = document.createElement('span');
			label.className = 'code-lang';
			label.textContent = lang;
			wrapper.appendChild(label);
		}

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-copy';
		button.textContent = '복사';
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
				button.textContent = '복사됨';
				button.classList.add('is-done');
			} catch {
				button.textContent = '실패';
			}
			setTimeout(() => {
				button.textContent = '복사';
				button.classList.remove('is-done');
			}, 1500);
		});
		wrapper.appendChild(button);
	}

	// 본문 이미지를 누르면 크게 보기 (링크로 감싼 이미지는 제외)
	const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
	const images = [...document.querySelectorAll<HTMLImageElement>('.prose img')].filter((img) => !img.closest('a'));
	if (lightbox && images.length > 0) {
		const big = lightbox.querySelector<HTMLImageElement>('.lightbox-img')!;
		const caption = lightbox.querySelector<HTMLElement>('.lightbox-caption')!;
		const count = lightbox.querySelector<HTMLElement>('.lightbox-count')!;
		const prev = lightbox.querySelector<HTMLButtonElement>('.lightbox-prev')!;
		const next = lightbox.querySelector<HTMLButtonElement>('.lightbox-next')!;
		let current = 0;

		// 캡션: 같은 문단의 <em>, 또는 바로 다음 문단의 <em> 한 줄
		const captionOf = (img: HTMLImageElement) => {
			const p = img.closest('p');
			const inline = p?.querySelector(':scope > em:last-child');
			if (inline) return inline.textContent ?? '';
			const after = p?.nextElementSibling;
			const em = after?.matches('p') && after.children.length === 1 ? after.querySelector(':scope > em') : null;
			return em?.textContent ?? '';
		};

		const show = (index: number) => {
			current = (index + images.length) % images.length;
			const img = images[current];
			big.src = img.currentSrc || img.src;
			big.alt = img.alt;
			caption.textContent = captionOf(img);
			count.textContent = images.length > 1 ? `${current + 1} / ${images.length}` : '';
		};

		const multiple = images.length > 1;
		prev.hidden = !multiple;
		next.hidden = !multiple;

		images.forEach((img, index) => {
			img.addEventListener('click', () => {
				show(index);
				lightbox.showModal();
			});
		});

		prev.addEventListener('click', () => show(current - 1));
		next.addEventListener('click', () => show(current + 1));
		lightbox.querySelector('.lightbox-close')!.addEventListener('click', () => lightbox.close());
		big.addEventListener('click', () => lightbox.close());
		// 이미지 바깥(어두운 배경)을 누르면 닫기
		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox || event.target === lightbox.querySelector('.lightbox-figure')) lightbox.close();
		});
		lightbox.addEventListener('keydown', (event) => {
			if (!multiple) return;
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});
		lightbox.addEventListener('close', () => big.removeAttribute('src'));
	}
</script>
