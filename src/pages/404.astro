---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/posts';
---

<BaseLayout title="페이지를 찾을 수 없어요">
	<div class="container not-found">
		<p class="code">404</p>
		<h1>페이지를 찾을 수 없어요</h1>
		<p>주소가 바뀌었거나 삭제된 글일 수 있어요.</p>
		<a href={withBase('/')}>홈으로 가기</a>
	</div>
</BaseLayout>

<style>
	.not-found {
		padding-top: 120px;
		text-align: center;
	}

	.code {
		margin: 0;
		font-size: 64px;
		font-weight: 800;
		color: var(--accent);
		letter-spacing: -0.04em;
	}

	h1 {
		margin: 8px 0 0;
		font-size: 26px;
	}

	p {
		color: var(--text-sub);
	}

	a {
		display: inline-block;
		margin-top: 16px;
		padding: 12px 20px;
		border-radius: var(--radius-sm);
		font-weight: 600;
		color: #fff;
		background: var(--accent);
	}
</style>
