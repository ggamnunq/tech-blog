---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPosts, withBase } from '../../lib/posts';

const tags = collectTags(await getPosts());
---

<BaseLayout title="태그" description="태그별로 글을 모아봅니다">
	<div class="container">
		<section class="page-head">
			<h1>태그</h1>
			<p>관심 있는 주제의 글을 모아서 볼 수 있어요.</p>
		</section>
		{
			tags.length > 0 ? (
				<ul class="tag-cloud">
					{tags.map((t) => (
						<li>
							<a class="chip" href={withBase(`tags/${t.slug}/`)}>
								#{t.tag}
								<span class="chip-count">{t.count}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">아직 태그가 없어요.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.empty {
		color: var(--text-muted);
	}
</style>
